# Spotify app Client ID (create one at https://developer.spotify.com/dashboard)
# Add redirect URI exactly: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=your_client_id_here

# Absolute path to your music root. Top-level subfolders are treated as genres.
#   ~/Music/Techno/...  -> genre "Techno"
#   ~/Music/Jazz/...    -> genre "Jazz"
MUSIC_ROOT=/Users/you/Music

# Playlist name template. {genre} is replaced.
PLAYLIST_TEMPLATE=Local: {genre}

# Minimum match confidence (0..1) before a track is added. Below this -> report.
MATCH_THRESHOLD=0.8

# Loopback port for the one-time OAuth callback.
CALLBACK_PORT=8888

# Comma-separated top-level folders to skip (case-insensitive).
IGNORE_GENRES=Fun, TEMP, z - spotify-genre-sync

# Min ms between Spotify requests. Higher = slower but safer against 429s.
# Dev-mode quota is low and unpublished; 334ms (~3 req/s) is a safe default.
# Raise to 500 if you still get rate-limited.
REQUEST_INTERVAL_MS=334
